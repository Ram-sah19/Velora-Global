# ==============================================================================
# Velora Global Backend Environment Configuration Template (.env.example)
# Duplicate this file to .env and configure values for your environment.
# ==============================================================================

# Server Port
PORT=5000

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/velora_global?retryWrites=true&w=majority

# Administrative Key for Protected Admin APIs
ADMIN_SECRET_KEY=your_secure_admin_secret_key_here

# Client Web Application Origin (for CORS configuration in Production)
CLIENT_ORIGIN=https://velora-global.online

# Email Service Configuration (Nodemailer / SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password_here

# Meta WhatsApp Business Cloud API Configuration (Optional)
WHATSAPP_TOKEN=your_meta_whatsapp_cloud_api_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
